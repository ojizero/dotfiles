#!/usr/bin/env zsh
#MISE description="Pull dotfiles and converge machine state"

old_ref="$(git -C "${DOTFILES_PATH}" rev-parse HEAD)"
git -C "${DOTFILES_PATH}" pull -p
# Apply dotfiles + tools only — avoid full bootstrap (defaults, extras); packages only when configs changed
# `-C` is required: without it repo-relative sources resolve against
# `~/.config/mise` and the apply aborts with "sources do not exist".
mise bootstrap dotfiles apply --yes -C "${DOTFILES_PATH}"
mise install
# `mise install` does not replace an installed version when only its npm
# package manager changed. Migrate legacy Bun installs, then no-op on later runs.
mise run dotfiles:migrate-aube

if [[ "$(readlink ~/.config/mise/miserc.local.toml)" != "${DOTFILES_PATH}/devices/"* ]]; then
  echo "This machine is not migrated yet: run \`zsh \"\${DOTFILES_PATH}/mise-tasks/dotfiles/migrate-devices\" <device>\`." >&2
elif git -C "${DOTFILES_PATH}" diff --name-only "${old_ref}" HEAD -- 'mise.toml' 'mise.*.toml' devices | grep -q .; then
  mise bootstrap packages apply --yes -C "${DOTFILES_PATH}"
fi

if git -C "${DOTFILES_PATH}" diff --name-only "${old_ref}" HEAD -- dotagent/agents.toml | grep -q .; then
  mise run dotfiles:agents
fi
