# Rootless Docker needs unprivileged user namespaces, which Ubuntu restricts
# to binaries with an AppArmor profile. Homebrew's rootlesskit lives here.
abi <abi/4.0>,
include <tunables/global>

"/home/linuxbrew/.linuxbrew/Cellar/rootlesskit/*/bin/rootlesskit" flags=(unconfined) {
  userns,

  include if exists <local/linuxbrew-rootlesskit>
}
