#!/usr/bin/env zsh
#MISE description="Trust the setup and runtime Mise configs"
set -e

DOTFILES_PATH="${DOTFILES_PATH:-${HOME}/workspace/self/dotfiles}"
mise trust "${DOTFILES_PATH}/mise.toml"
for config in "${DOTFILES_PATH}"/mise.*.toml(N) "${DOTFILES_PATH}"/mise/config*.toml(N); do
  mise trust "${config}"
done
