# Agent-desktop override of the Zen Flatpak's desktop entry: opens the agent profile
[Desktop Entry]
Version=1.0
Type=Application
Name=Zen Browser
GenericName=Web Browser
Comment=A fast, private and secure web browser (agent profile)
Exec=zen %u
Icon=app.zen_browser.zen
StartupWMClass=zen
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
X-Flatpak=app.zen_browser.zen
