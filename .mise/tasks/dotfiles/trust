#!/usr/bin/env zsh
#MISE description="Trust the repo mise configs"
# A task, not an inline bootstrap hook: hooks get neither `[env]` nor template
# rendering, so `${DOTFILES_PATH}` was empty and `mise trust "/.mise.toml"`
# silently trusted `/`.
mise trust "${DOTFILES_PATH}/.mise.toml"
mise trust "${DOTFILES_PATH}/.mise.local.toml" 2>/dev/null || true

# Machine modules (.mise.<module>.toml), selected per machine in ~/.config/mise/miserc.local.toml
for module in "${DOTFILES_PATH}"/.mise.*.toml(N); do
  [[ "${module:t}" == ".mise.local.toml" ]] || mise trust "${module}"
done
