# Font
font-family = FiraCode Nerd Font Mono
font-style = Retina
font-size = 16
font-feature = calt
font-feature = liga

# Window
window-width = 80
window-height = 25

# Background (transparency disabled - interacts poorly with split pane dimming)
# background-opacity = 0.68
# background-opacity-cells = true
# background-blur = 16

# Theme - auto-switch with system appearance
theme = light:catppuccin-latte,dark:catppuccin-mocha

# Cursor
cursor-style = block
cursor-style-blink = true

# Scrollback (100MB - approximate "unlimited")
scrollback-limit = 100000000

# Bell - dock bounce on bell (audio silenced, no visual-flash equivalent in Ghostty)
bell-features = attention

# Clipboard
clipboard-read = allow
copy-on-select = false

unfocused-split-opacity = 0.5
split-inherit-working-directory = true

# Confirm close/quit only when a process is running (shell-integration detected)
confirm-close-surface = true

# Shell integration (no-cursor: keep block cursor at prompt instead of bar).
# Prepare SSH sessions with Ghostty's environment and terminfo so remote shells
# and terminal applications decode keys consistently.
shell-integration = detect
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Bold text uses bright colors
bold-color = bright

# macOS specific
macos-icon = xray
macos-option-as-alt = true
macos-titlebar-style = tabs

# Keybindings
# Cmd+Backspace = backward kill line (Ctrl-U)
keybind = super+backspace=text:\x15
# Cmd+Left = beginning of line (Ctrl-A)
keybind = super+left=text:\x01
# Cmd+Right = end of line (Ctrl-E)
keybind = super+right=text:\x05
# Option+Backspace = backward delete word (ESC DEL)
keybind = alt+backspace=text:\x1b\x7f

# macOS Ghostty defaults, spelled out so Linux (where Cmd is Super) matches
keybind = super+k=clear_screen
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+left_bracket=goto_split:previous
keybind = super+right_bracket=goto_split:next
keybind = super+shift+left_bracket=previous_tab
keybind = super+shift+right_bracket=next_tab
keybind = super+shift+enter=toggle_split_zoom
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1
keybind = super+digit_1=goto_tab:1
keybind = super+digit_2=goto_tab:2
keybind = super+digit_3=goto_tab:3
keybind = super+digit_4=goto_tab:4
keybind = super+digit_5=goto_tab:5
keybind = super+digit_6=goto_tab:6
keybind = super+digit_7=goto_tab:7
keybind = super+digit_8=goto_tab:8
keybind = super+digit_9=last_tab
